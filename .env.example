# Use the Neon connection strings from your Neon project. Do not commit real credentials.
# DATABASE_URL: the pooled connection (host contains "-pooler") — used at runtime.
# DIRECT_URL: the direct, non-pooled connection — used for migrations.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<database>?sslmode=require"

# Public URL of this deployment.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
